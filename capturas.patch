+<script>
+// Capturas: varias imágenes con miniatura y opción de quitar antes de guardar. La lista real vive en el input.
+document.addEventListener("DOMContentLoaded", function () {
+    const entrada = document.getElementById("capturas-input");
+    const zona = document.getElementById("capturas-dropzone");
+    const vista = document.getElementById("capturas-preview");
+    if (!entrada || !zona || !vista) return;
+    let archivos = [];
+
+    function sincronizar() {
+        const lista = new DataTransfer();
+        archivos.forEach(function (f) { lista.items.add(f); });
+        entrada.files = lista.files;
+        vista.innerHTML = "";
+        archivos.forEach(function (f, i) {
+            const miniatura = document.createElement("div");
+            miniatura.className = "captura-thumb";
+            miniatura.title = f.name;
+            const imagen = document.createElement("img");
+            imagen.alt = f.name;
+            imagen.style.cssText = "width:100%;height:100%;object-fit:cover;";
+            imagen.src = URL.createObjectURL(f);
+            const quitar = document.createElement("button");
+            quitar.type = "button";
+            quitar.className = "remove-captura";
+            quitar.title = "Quitar";
+            quitar.textContent = "✕";
+            quitar.addEventListener("click", function (ev) {
+                ev.stopPropagation();
+                archivos.splice(i, 1);
+                sincronizar();
+            });
+            miniatura.appendChild(imagen);
+            miniatura.appendChild(quitar);
+            vista.appendChild(miniatura);
+        });
+    }
+    function agregar(nuevos) {
+        Array.from(nuevos).forEach(function (f) {
+            if (f.type === "image/png" || f.type === "image/jpeg") archivos.push(f);
+        });
+        sincronizar();
+    }
+    entrada.addEventListener("change", function () { agregar(entrada.files); });
+    zona.addEventListener("click", function () { entrada.click(); });
+    zona.addEventListener("dragover", function (e) { e.preventDefault(); });
+    zona.addEventListener("drop", function (e) { e.preventDefault(); agregar(e.dataTransfer.files); });
+});
+</script>
